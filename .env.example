# Telegram — do BotFather
TELEGRAM_BOT_TOKEN=
# Seu chat_id: fale com o @userinfobot no Telegram
TELEGRAM_CHAT_ID=
# Segredo do webhook — gere com: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Protege o cron da Vercel — gere com: openssl rand -hex 32
CRON_SECRET=

# Supabase — OBRIGATORIO. Sem isso nao existe memoria entre mensagens.
# Use a connection string do Transaction pooler (porta 6543), regiao Sao Paulo.
DATABASE_URL=

# Ponte com o worker no Mac — gere com: openssl rand -hex 32
# A MESMA chave vai no ~/.coach-worker.env e nas variaveis do Vercel.
WORKER_KEY=

# intervals.icu — ponte para o relogio (ver docs/adr/0006)
# Chave: intervals.icu > Settings > Developer > API Key
# Athlete ID: aparece na URL do seu perfil, no formato i123456
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=
